{
  // Cloudflare Workers static-assets config.
  // The site is plain HTML/CSS/JS, so there is no Worker script — Cloudflare
  // serves dist/ straight from its edge network.
  //
  // Cloudflare build settings that go with this:
  //   Build command   node build.mjs
  //   Deploy command  npx wrangler deploy
  "name": "g-gorgeous-demo",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // serve 404.html with a real 404 status for unknown paths
    "not_found_handling": "404-page"
  }
}
