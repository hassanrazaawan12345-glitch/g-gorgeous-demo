# Cloudflare headers. vercel.json mirrors this so either host works.

# Photos get a new filename whenever they change, so they can be cached hard.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Code keeps the SAME filename across deploys, so it must be revalidated
# every time. "no-cache" does not mean "do not store" — the browser keeps
# the file and gets a fast 304 when it has not changed. Caching these for
# days left phones running stale JavaScript with no way to update.
/assets/js/*
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
